{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@hunt-command/shared": ["./packages/shared/src/index.ts"],
      "@hunt-command/telemetry": ["./packages/telemetry/src/index.ts"],
      "@hunt-command/data-plane": ["./packages/data-plane/src/index.ts"],
      "@hunt-command/daemon": ["./packages/daemon/src/index.ts"],
      "@hunt-command/coach": ["./packages/coach/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "out",
    "release",
    ".worktrees"
  ]
}
